# Skwoop bridge config. Copy to ~/.skwoop/env (chmod 600) and fill in.
# Never commit the filled-in copy. The bridge only reads these from the environment.

# --- network (LAN only) ---
SKWOOP_PORT=8003

# --- device auth (a LAN pairing token, not an API key) ---
SKWOOP_DEVICE_TOKEN=changeme
SKWOOP_ALLOWED_DEVICES=

# --- several pods (one bridge) ---
# SKWOOP_ROOMS='{"aa:bb:cc:dd:ee:01":"office","aa:bb:cc:dd:ee:02":"kitchen"}'
# SKWOOP_DEFAULT_ROOM=office

# --- deep model (OpenAI-compatible HTTP) ---
LLM_MODE=deep
DEEP_MODEL_BASE_URL=http://127.0.0.1:8000/v1
DEEP_MODEL_API_KEY=changeme
DEEP_MODEL_NAME=deep
# DEEP_MODEL_PROVIDER=
# DEEP_MODEL_PROMPT_FILE=~/.skwoop/agent/webhook_subscriptions.json
LLM_FALLBACK_XAI=1
# Hosts the bridge must not call (comma-separated). Empty allows any host the URL names.
# SKWOOP_FORBIDDEN_LLM_HOSTS=

# --- direct model (fallback) ---
XAI_API_KEY=changeme
XAI_MODEL=grok-4.20-0309-non-reasoning

# --- speech ---
STT_PROVIDER=xai
TTS_PROVIDER=elevenlabs
XAI_TTS_VOICE=eve
# XAI_FALLBACK_VOICE=carina
ELEVENLABS_API_KEY=changeme
ELEVENLABS_VOICE_ID=changeme
# ELEVENLABS_MODEL=eleven_v4_turbo

# --- webhook for deep turns that do not stream ---
# SKWOOP_WEBHOOK_URL=
# SKWOOP_WEBHOOK_SECRET=changeme
# AGENT_STATE_DB=~/.skwoop/agent/state.db
# SKWOOP_SESSION_DIR=~/.skwoop/sessions

# --- status feed ---
STATUS_WRITE_KEY=changeme
STATUS_READ_KEY=changeme
STATUS_FILE=~/.skwoop/status.json

# --- memory service ---
# MEMORY_SERVICE_URL=http://127.0.0.1:9177/v1/default/banks/skwoop
# MEMORY_RECALL_URL=http://127.0.0.1:9177/v1/default/banks/skwoop/memories/recall

# --- house ---
# ATV_LOOKUP_DIR=~/.skwoop/media-lookup
# SKWOOP_CONTACTS_FILE=~/.skwoop/contacts.yaml
# SKWOOP_TEXT_SENDER=~/.skwoop/send_text.py
# SKWOOP_NOTES_DIR=~/.skwoop/notes
# SKWOOP_NOTES_LOOSE=

# --- music ---
# SPOTIFY_AUTH_PATH=~/.skwoop/spotify-auth.json
# SPOTIFY_REFRESH_CMD=

# --- clips and credits ---
# SKWOOP_LIBRARY_DIR=~/.skwoop/skwoop-lib
# SKWOOP_LIBRARY=1
# ACK_DIR=~/.skwoop/acks
# INBOX_DIR=~/.skwoop/inbox
# ELEVEN_CREDIT_STATE=~/.skwoop/eleven-credits.json
# ELEVEN_CREDIT_BALANCE=
# ELEVEN_CREDIT_FLOOR=1000

# --- web pod ---
# WEBPOD_KEY=changeme
# WEBPOD_TLS_DIR=~/.skwoop/webpod-tls
# WEBPOD_BRIDGE_URL=ws://127.0.0.1:8003/xiaozhi/v1/
