<?xml version="1.0" encoding="UTF-8"?>
<!-- Example launchd agent for the web pod sidecar. Set the path to webpod/run.sh. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.skwoop.webpod</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>/path/to/skwoop/bridge/webpod/run.sh</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/skwoop-webpod.log</string>
  <key>StandardErrorPath</key><string>/tmp/skwoop-webpod.log</string>
</dict>
</plist>
